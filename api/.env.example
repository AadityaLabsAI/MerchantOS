# MerchantOS API — environment template
# Copy to .env.development (dev) or .env.production and fill in.
# DO NOT commit .env files with real secrets.

NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://merchantos:CHANGE_ME@127.0.0.1:5432/merchantos
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# JWT secrets (>= 32 chars each, MUST differ). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=change-me-to-48-bytes-of-random-data-32chars-min-aaaa
JWT_REFRESH_SECRET=change-me-to-48-bytes-of-random-data-32chars-min-bbbb
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Webhook HMAC (32+ chars). Only needed if you wire a real provider.
WEBHOOK_HMAC_SECRET=change-me-to-48-bytes-of-random-data-32chars-min-cccc
WEBHOOK_TOLERANCE_SECONDS=300

API_BASE_URL=http://localhost:3000
WEB_BASE_URL=http://localhost:3000
CORS_ORIGINS=
TRUSTED_PROXIES=

# Payment simulator is OFF by default. Set to true only in development
# if you want /api/dev/simulate-success to be reachable.
ENABLE_PAYMENT_SIMULATOR=false

# AI is OFF by default. Set AI_ENABLED=true and start Ollama locally
# if you want the in-app assistant.
AI_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b-instruct-q5_K_M
AI_TIMEOUT_SECONDS=20

PAYMENT_DEFAULT_TTL_SECONDS=600
LOG_LEVEL=info
