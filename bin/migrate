#!/usr/bin/env bash
# MerchantOS migration runner. Applies all *.sql in migrations/ in lexical order.
# Idempotent: tracks applied versions in schema_migrations.
set -euo pipefail

cd "$(dirname "$0")/.."

: "${DATABASE_URL:=postgres://postgres@127.0.0.1:5432/merchantos}"

# If PG* variables were not supplied explicitly, derive them from DATABASE_URL.
# Use command substitutions instead of eval so credentials cannot become shell code.
if [ -z "${PGHOST:-}" ] || [ -z "${PGPORT:-}" ] || [ -z "${PGUSER:-}" ] || [ -z "${PGDATABASE:-}" ]; then
  PGHOST="${PGHOST:-$(node -e 'const u=new URL(process.env.DATABASE_URL);process.stdout.write(u.hostname)')}"
  PGPORT="${PGPORT:-$(node -e 'const u=new URL(process.env.DATABASE_URL);process.stdout.write(u.port||"5432")')}"
  PGUSER="${PGUSER:-$(node -e 'const u=new URL(process.env.DATABASE_URL);process.stdout.write(decodeURIComponent(u.username))')}"
  PGDATABASE="${PGDATABASE:-$(node -e 'const u=new URL(process.env.DATABASE_URL);process.stdout.write(decodeURIComponent(u.pathname.replace(/^\\//,"")))')}"
fi
if [ -z "${PGPASSWORD:-}" ]; then
  PGPASSWORD="$(node -e 'const u=new URL(process.env.DATABASE_URL);process.stdout.write(decodeURIComponent(u.password))')"
fi
: "${PGHOST:=127.0.0.1}"; : "${PGPORT:=5432}"; : "${PGUSER:=postgres}"; : "${PGDATABASE:=merchantos}"
export PGHOST PGPORT PGUSER PGDATABASE PGPASSWORD

if ! command -v psql >/dev/null 2>&1; then
  echo "psql not found. Install postgresql-client." >&2
  exit 1
fi

# Create database if missing
psql -d postgres -tAc "SELECT 1 FROM pg_database WHERE datname='${PGDATABASE}'" | grep -q 1 \
  || psql -d postgres -c "CREATE DATABASE ${PGDATABASE}"

# Bootstrap migrations table
psql -v ON_ERROR_STOP=1 -c "CREATE TABLE IF NOT EXISTS schema_migrations (version text PRIMARY KEY, applied_at timestamptz NOT NULL DEFAULT now(), description text);"

applied() {
  psql -tAc "SELECT version FROM schema_migrations" | sort -u
}

for f in $(ls database/migrations/*.sql | sort); do
  base=$(basename "$f" .sql)
  if applied | grep -qx "$base"; then
    echo "[skip] $base"
  else
    echo "[apply] $base"
    psql -v ON_ERROR_STOP=1 -f "$f"
    # Record success only after the entire migration file has applied.
    psql -v ON_ERROR_STOP=1 -c "INSERT INTO schema_migrations (version, description) VALUES ('$base', '$base') ON CONFLICT (version) DO NOTHING"
  fi
done

echo "Migrations complete."
