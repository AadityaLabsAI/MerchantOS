# Copy to .env and fill in real secrets before running `docker compose up -d`
# Generate with:  openssl rand -base64 48
POSTGRES_PASSWORD=change-me-postgres-password
JWT_ACCESS_SECRET=change-me-48-bytes-base64
JWT_REFRESH_SECRET=change-me-48-bytes-base64
WEBHOOK_HMAC_SECRET=change-me-48-bytes-base64

API_BASE_URL=https://api.your-domain.com
WEB_BASE_URL=https://your-domain.com
CORS_ORIGINS=https://your-domain.com

AI_ENABLED=false
OLLAMA_BASE_URL=http://host.docker.internal:11434

SEED_USER_EMAIL=owner@your-domain.com
SEED_USER_PASSWORD=change-me
SEED_STORE_ID=01H0000000000000000000001
SEED_USER_ROLE=OWNER
